# Findora Environment Configuration
# Copy this file to .env or .env.local to configure your live Supabase database

# Supabase Project URL (From Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (Browser-safe)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Application Configuration
VITE_APP_NAME="Findora"
VITE_APP_TAGLINE="Lost something? Let's bring it back."
